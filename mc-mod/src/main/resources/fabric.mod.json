{
  "schemaVersion": 1,
  "id": "wackasm",
  "version": "${version}",
  "name": "Wackasm for OpenComputers",
  "description": "Adds a WebAssembly architecture to OpenComputers: Modernized, powered by the wackasm interpreter. Machines can be suspended mid-call and survive world reloads.",
  "authors": ["DecDuck"],
  "contributors": ["OpenComputers by Sangar and contributors; OpenComputers: Modernized by habzg and contributors"],
  "contact": {
    "homepage": "https://decduck.github.io/wackasm/",
    "sources": "https://github.com/DecDuck/wackasm",
    "issues": "https://github.com/DecDuck/wackasm/issues"
  },
  "license": "MIT",
  "icon": "assets/wackasm/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.wackasm.oc.WackasmMod"],
    "client": ["dev.wackasm.oc.WackasmClient"],
    "server": ["dev.wackasm.oc.WackasmServer"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "opencomputers": ">=${ocm_version}"
  }
}
